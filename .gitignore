# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
src/fashion_agent/.env
# Runtime data. None of it belongs in version control: it is one person's
# photographs, measurements and conversations, and it changes on every run.
data/*.sqlite3
data/*.sqlite3-wal
data/*.sqlite3-shm
data/search_cache.json
data/wardrobe_images/

# Kept on purpose, because the app cannot start without them:
#   data/taste_cards.json   the collection index
#   data/outfit_cards/      the collection's photographs
